# Non-secret settings only. Secret values are mounted as files by
# compose.example.yml; never put their contents in this file.
BFF_LISTEN_ADDR=:8090
BFF_DATABASE_PATH=/data/companion.db
BFF_ALLOWED_JELLYFIN_USER_IDS=replace-with-jellyfin-user-id
BFF_ALLOW_ALL_JELLYFIN_USERS=false
BFF_ALLOW_CANCEL=false
BFF_SESSION_TTL=12h
BFF_SELECTION_TTL=10m
BFF_RECONCILE_INTERVAL=10s
BFF_SEARCH_TIMEOUT=2m
BFF_UPSTREAM_TIMEOUT=30s

RADARR_URL=http://radarr:7878
RADARR_ROOT_FOLDER=/data/media/movies
RADARR_QUALITY_PROFILE_ID=1
SONARR_URL=http://sonarr:8989
SONARR_ROOT_FOLDER=/data/media/tv
SONARR_QUALITY_PROFILE_ID=1
JELLYFIN_URL=http://jellyfin:8096

# Leave blank to disable optional qBittorrent metrics.
QBITTORRENT_URL=
